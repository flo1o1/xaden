#!/usr/bin/env bash
# Git commit-msg hook: enforce Conventional Commits (drives SemVer decisions).
set -euo pipefail

first_line="$(head -n 1 "$1")"
pattern='^(feat|fix|refactor|docs|test|chore|perf|build|ci|style|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'

case "$first_line" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "ERROR: commit message must follow Conventional Commits:" >&2
  echo "  <type>(<scope>)!: <summary up to 72 chars>" >&2
  echo "  types: feat fix refactor docs test chore perf build ci style revert" >&2
  exit 1
fi
