#!/usr/bin/env bash
# Git pre-commit hook: fast, offline checks on staged files (scripts/check.sh --staged).
# The full run (types, tests, audits) happens in CI and before releases.
# Bypass in emergencies with `git commit --no-verify` (CI still runs the checks).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/check.sh" --staged

# Nudge: code changed but requirements untouched.
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -Evq '^(docs/|prompts/|\.|[A-Z]+\.md$|VERSION$)' &&
   ! printf '%s\n' "$staged" | grep -q '^docs/requirements/'; then
  echo "NOTE: code staged without a requirements update. Did scope change?" >&2
fi
